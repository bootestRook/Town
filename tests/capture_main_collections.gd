extends "res://tests/capture_main_ui.gd"

func _run() -> void:
	root.unfocusable = true
	root.position = Vector2i(-4000, 0)
	root.size = Vector2i(750, 1334)
	_app = load("res://scenes/main.tscn").instantiate()
	root.add_child(_app)
	await _settle()
	_hud = _app.get_node("Interface/MainHUD")
	var op = _app._operations
	op._state.inventory["item.200001"] = 2
	op._state.inventory["item.13016"] = 1
	op._state.inventory["item.11310"] = 100
	op._state.inventory["item.13001"] = 500
	op._state.coins = 300000
	op.main_command({"type": "item_use", "item": 200001})
	op.main_command({"type": "item_use", "item": 13016})
	_click(_hud.get_node("Stage/Bottom/Nav2"))
	await _settle()
	_click(_hud.get_node("Stage/HeroRoster/Scroll/Grid").get_child(0).get_node("Open"))
	await _settle()
	var dialog = _hud.get_node("Stage/Dialogs")
	var detail = _hud.get_node("Stage/HeroDetail")
	var hero: String = detail.hero_id
	await _capture("20_hero_tabs")
	_click(detail.get_node("Bottom/Tab3"))
	await _settle()
	await _capture("21_hero_inventory")
	_click(detail.get_node("Bottom/Tab1"))
	await _settle()
	_check(detail.tab == 1, "native pet tab")
	await _capture("22_hero_pet_empty")
	_click(detail.get_node("CollectionPage/Scroll/Rows").get_child(0))
	await _settle()
	_check(dialog.kind == "collection_inventory", "native pet inventory")
	_click(dialog.get_node("Panel/Scroll/Rows").get_child(0))
	await _settle()
	await _capture("23_pet_details")
	_click(dialog.get_node("Panel/Alternate"))
	await _settle()
	_check(op.snapshot().main.collections[0].hero == hero, "pet equip through native input")
	_click(dialog.get_node("Panel/Action"))
	await _settle()
	_check(op.snapshot().main.collections[0].level == 2, "pet upgrade through native input")
	_click(dialog.get_node("Panel/Close"))
	_click(dialog.get_node("Panel/Close"))
	await _settle()
	_check(not dialog.visible and detail.visible and detail.tab == 1, "pet history returns to owning tab")
	await _capture("24_hero_pet_equipped")
	_click(detail.get_node("Bottom/Tab2"))
	await _settle()
	_click(detail.get_node("CollectionPage/Scroll/Rows").get_child(0))
	await _settle()
	_click(dialog.get_node("Panel/Scroll/Rows").get_child(0))
	await _settle()
	await _capture("25_artifact_details")
	_click(dialog.get_node("Panel/Alternate"))
	await _settle()
	_check(op.snapshot().main.collections[1].hero == hero, "artifact equip through native input")
	_hud.close()
	# Gift tabs were removed by the diamond-only recharge brief. Gift rules remain domain-tested.
	root.size = Vector2i(360,640)
	_hud.navigate("heroes")
	await _settle()
	_click(_hud.get_node("Stage/HeroRoster/Scroll/Grid").get_child(0).get_node("Open"))
	await _settle()
	await _capture("hero_detail_360_640")
	_click(detail.get_node("Bottom/Back"))
	_click(_hud.get_node("Stage/HeroRoster/Scroll/Grid").get_child(0).get_node("Open"))
	await _settle()
	var order: Array = detail._order.duplicate()
	_check(order.size() == op.snapshot().heroes.size(), "map roster order follows actual ownership")
	_click(detail.get_node("Previous"))
	await _settle()
	_check(detail.hero_id == order[0], "previous at first hero stays within visible list")
	_click(detail.get_node("Next"))
	await _settle()
	_check(detail.hero_id == order[1], "next hero follows combat sorted visible order")
	for i in order.size():
		_click(detail.get_node("Next"))
		await _settle()
	_check(detail.hero_id == order[-1], "next at last hero stays within visible list")
	if _failures.is_empty(): print("[OK] Collections UI native input and 12 captures")
	else:
		for message in _failures: push_error(message)
	_app.queue_free()
	await process_frame
	quit(0 if _failures.is_empty() else 1)
