extends "res://tests/capture_main_ui.gd"

func _run() -> void:
	root.unfocusable = true
	root.position = Vector2i(-4000,0)
	root.size = Vector2i(750,1334)
	_app = load("res://scenes/main.tscn").instantiate()
	root.add_child(_app)
	await _settle()
	_app.set_process(false)
	_hud = _app.get_node("Interface/MainHUD")
	var op = _app._operations
	var detail = _hud.get_node("Stage/HeroDetail")
	var dialog = _hud.get_node("Stage/Dialogs")
	_click(_hud.get_node("Stage/Bottom/Nav2"))
	await _settle()
	_click(_hud.get_node("Stage/HeroRoster/Scroll/Grid").get_child(0).get_node("Open"))
	await _settle()
	_check(detail.visible and not dialog.visible, "hero opens dedicated full-screen page")
	var id: String = detail.hero_id
	var live: Dictionary = op._state.heroes.filter(func(h): return h.id == id)[0]
	live.needs.tired = 46
	_hud.render(op.snapshot())
	for dimensions in [Vector2i(750,1334),Vector2i(360,640),Vector2i(750,1624)]:
		root.size = dimensions
		await _settle()
		await _capture("hero_info_%d_%d" % [dimensions.x,dimensions.y])
		_check(detail.get_node("AttributePage/Promotion/Upgrade").get_global_rect().end.y < detail.get_node("Bottom").get_global_rect().position.y, "promotion clears bottom navigation")
		for i in 4:
			_click(detail.get_node("Status%d" % i))
			await _settle()
			_check(detail.get_node("Tooltip").visible and detail._tooltip == i, "status tap switches anchored tooltip")
			await _capture("hero_info_tip_%d_%d_%d" % [i,dimensions.x,dimensions.y])
		_click(detail.get_node("Status3"))
		_check(not detail.get_node("Tooltip").visible, "same status tap closes tooltip")
	root.size = Vector2i(750,1334)
	await _settle()
	_click(detail.get_node("Status0"))
	_click(detail.get_node("PortraitArea/Portrait"))
	_check(not detail.get_node("Tooltip").visible, "outside tap dismisses local tooltip")
	_click(detail.get_node("Status2"))
	_click(detail.get_node("Next"))
	_check(detail.hero_id != id and not detail.get_node("Tooltip").visible, "hero switch clears tooltip")
	_click(detail.get_node("Previous"))
	_click(detail.get_node("Status1"))
	_click(detail.get_node("Bottom/Tab1"))
	_check(detail.tab == 1 and not detail.get_node("Tooltip").visible, "pet tab clears tooltip")
	_click(detail.get_node("Bottom/Tab0"))
	_click(detail.get_node("AttributePage/Skill0"))
	await _settle()
	_check(_hud.get_node("Stage/SkillTooltip").visible and not dialog.visible, "actual skill icon opens inline description")
	_click(detail.get_node("AttributePage/Skill0"))
	_click(detail.get_node("Wallet"))
	await _settle()
	var coins: int = op.snapshot().coins
	var wallet: int = live.wallet
	dialog.get_node("Panel/NameInput").text = "123"
	_click(dialog.get_node("Panel/Action"))
	await _settle()
	_check(op.snapshot().coins == coins - 123 and live.wallet == wallet + 123, "private wallet plus donates real public gold")
	_click(dialog.get_node("Panel/Close"))
	_click(detail.get_node("EquipmentSettings"))
	await _settle()
	_check(dialog.kind == "hero_equipment", "equipment settings opens inventory actions")
	_click(dialog.get_node("Panel/Close"))
	_check(op.craft("forge.20101",1).accepted, "craft actual armor for equipment input fixture")
	_hud.render(op.snapshot())
	_click(detail.get_node("Slot2"))
	await _settle()
	_click(dialog.get_node("Panel/Scroll/Rows").get_child(0))
	await _settle()
	_check(live.equipment.has("2"), "slot selection equips actual inventory item")
	_click(dialog.get_node("Panel/Close"))
	await _capture("hero_info_equipped")
	_check(detail.get_node("Slot2/Frame").visible, "equipped transparent artwork has actual quality frame")
	_click(detail.get_node("Slot2"))
	await _settle()
	var equipment = _hud.get_node("Stage/EquipmentDetail")
	_click(equipment.get_node("Panel/Buyback"))
	_click(equipment.get_node("Confirm/Card/Accept"))
	await _settle()
	_check(not live.equipment.has("2"), "equipped slot can return armor to inventory")
	_click(detail.get_node("Slot8"))
	await _settle()
	_check(dialog.kind == "hero_equipment" and dialog._data.slot == 8, "artifact slot opens equipped collection management")
	_click(dialog.get_node("Panel/Close"))
	var before: Dictionary = op.snapshot().main.roster.filter(func(h): return h.id == id)[0]
	_click(detail.get_node("AttributePage/Promotion/Upgrade"))
	await _settle()
	_check(op.snapshot().main.roster.filter(func(h): return h.id == id)[0].star == before.star, "insufficient fragments do not raise star")
	op._state.main.fragments[before.definition] = before.fragment_cost
	_hud.render(op.snapshot())
	_click(detail.get_node("AttributePage/Promotion/Upgrade"))
	await _settle()
	_check(op.snapshot().main.roster.filter(func(h): return h.id == id)[0].star > before.star, "promotion consumes fragments and updates hero")
	_click(detail.get_node("Change"))
	await _settle()
	var management = _hud.get_node("Stage/HeroManagement")
	_check(management.visible and management.tab == 0, "change hero navigates to source formation")
	_click(management.get_node("Bottom/Tab1"))
	await _settle()
	_click(management.get_node("TrainingScroll/Rows").get_child(1).get_node("Card"))
	await _settle()
	_check(detail.hero_id != id and detail.visible and not dialog.visible, "training changes full-screen hero")
	_click(detail.get_node("Bottom/Back"))
	_click(management.get_node("Bottom/Back"))
	_check(_hud.get_node("Stage/HeroRoster").visible and not detail.visible, "return arrow restores roster")
	if _failures.is_empty(): print("[OK] Hero information native input, four anchored tooltips, three viewport sizes, wallets, skills and promotion")
	else:
		for message in _failures: push_error(message)
	_app.queue_free()
	await process_frame
	quit(0 if _failures.is_empty() else 1)
